---
layout: none
---
[
  {% for article in site.articles %}
    {
      "title": {{ article.title | jsonify }},
      "track": {{ article.track | jsonify }},
      "order": {{ article.order | jsonify }},
      "abstract": {{ article.abstract | jsonify }},
      "tags": {{ article.tags | jsonify }},
      "url": {{ article.url | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
